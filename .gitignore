# macOS
.DS_Store

# Brainstorming visual companion artifacts
.superpowers/

# Swift / SPM build artifacts
.build/
.swiftpm/
Packages/
# ...but DO track our local SwiftPM packages (vendored source, not SPM checkouts)
!app/Packages/
!app/Packages/**
# (re-ignore build artifacts inside those packages)
app/Packages/**/.build/
app/Packages/**/.swiftpm/
*.xcodeproj
*.xcworkspace
app/build/

# Release output (notarized .dmg, xcarchive, export) — see scripts/release.sh
/build/

# Signing material & secrets — never commit (private keys are sensitive)
*.cer
*.p12
*.certSigningRequest
*.mobileprovision
*.provisionprofile

# POC compiled binaries (rebuild via swiftc — see poc/README.md)
poc/sealshot-spike
poc/generate-smoke
poc/generate-all
poc/inspect-ocr
poc/overlay/overlay-spike

# POC fixture outputs (regenerated by the harness)
poc/fixtures/*.annotated.png
poc/fixtures/*.detections.json
poc/fixtures/smoke-synthetic.png

# Stray capture artifacts from the resolution-modify spike
poc/resolution-modify/*.png
poc/resolution-modify/*.seal

# Local Claude Code state/worktrees
.claude/
scripts/dmg/assets/
